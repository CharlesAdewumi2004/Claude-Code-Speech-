{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/speak.py\"",
            "timeout": 10,
            "statusMessage": "Speaking..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/speak.py\" --stop",
            "timeout": 20,
            "async": true
          }
        ]
      }
    ]
  }
}
